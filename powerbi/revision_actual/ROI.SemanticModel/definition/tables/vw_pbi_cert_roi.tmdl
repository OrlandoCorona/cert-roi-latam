table vw_pbi_cert_roi
	lineageTag: ca0f4028-4b56-412c-9aa5-3122bd7d5225

	measure 'Total Certs' = COUNTROWS(vw_pbi_cert_roi)
		formatString: #,0
		lineageTag: d66bdb71-4564-4739-8eed-51f76e95b68d

	measure 'Vacantes Analizadas' = SUM(vw_pbi_kpis[total_vacantes])
		formatString: #,0
		lineageTag: 2f27ac38-b21a-4b16-bd93-4211f0d8f465

	measure 'Inversión Promedio MXN' = AVERAGE(vw_pbi_roi_escenario_v2[inversion_total_mxn])
		formatString: #,0
		lineageTag: 03a370d7-4260-4380-9a6d-25ab0ceb9b44

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Vacantes con Cert' = SUM(vw_pbi_kpis[vacantes_con_cert])
		formatString: #,0
		lineageTag: 77364bb8-6802-4d13-ae04-9fba2d5c6da2

	measure '% Mercado con Cert' = DIVIDE([Vacantes con Cert], [Vacantes Analizadas], 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5e042aac-cac4-4170-b0a2-2d7de025d202

	/// Promedio del escenario de ROI incremental bajo los supuestos de la tabla v2. No retorno observado.
	measure 'ROI Promedio' = AVERAGE(vw_pbi_roi_escenario_v2[roi_fraccion])
		formatString: 0.0%
		lineageTag: b8516b96-3cf8-426c-bd4b-2af06e6d79ad

	/// Maximo del escenario; no evidencia de mayor retorno real de una certificacion.
	measure 'Mejor ROI' = MAX(vw_pbi_roi_escenario_v2[roi_fraccion])
		formatString: 0.0%
		lineageTag: ab79b037-4d91-420f-a62b-9d10b75c9fdf

