          },
          {
            "name": "Vacantes Analizadas",
            "expression": "SUM(vw_pbi_kpis[total_vacantes])",
            "formatString": "#,0",
            "lineageTag": "2f27ac38-b21a-4b16-bd93-4211f0d8f465",
            "dataType": "int64",
            "modifiedTime": "2026-10-30T04:43:03.423333",
            "structureModifiedTime": "2026-10-30T01:22:31.186667"
          },
          {
            "name": "Inversión Promedio MXN",
            "expression": "AVERAGE(vw_pbi_roi_escenario_v2[inversion_total_mxn])",
            "formatString": "#,0",
            "lineageTag": "03a370d7-4260-4380-9a6d-25ab0ceb9b44",
            "dataType": "decimal",
            "modifiedTime": "2026-11-01T07:14:52.74",
