            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}",
                "modifiedTime": "2026-10-30T05:09:09.586667"
              }
            ]
          },
          {
            "name": "Vacantes con Cert",
            "expression": "SUM(vw_pbi_kpis[vacantes_con_cert])",
            "formatString": "#,0",
            "lineageTag": "77364bb8-6802-4d13-ae04-9fba2d5c6da2",
            "dataType": "int64",
            "modifiedTime": "2026-10-30T04:44:02.223333",
            "structureModifiedTime": "2026-10-30T04:43:48.226667"
          },
          {
            "name": "% Mercado con Cert",
            "expression": "DIVIDE([Vacantes con Cert], [Vacantes Analizadas], 0)",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "5e042aac-cac4-4170-b0a2-2d7de025d202",
            "dataType": "double",
            "modifiedTime": "2026-10-30T05:04:43.25",
            "structureModifiedTime": "2026-10-30T04:44:18.233333"
          },
          {
            "name": "ROI Promedio",
            "description": "Promedio del escenario de ROI incremental bajo los supuestos de la tabla v2. No retorno observado.",
