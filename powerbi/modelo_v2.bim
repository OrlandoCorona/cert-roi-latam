        "measures": [
          {
            "name": "Total Certs",
            "expression": "COUNTROWS(vw_pbi_cert_roi)",
            "formatString": "#,0",
            "lineageTag": "d66bdb71-4564-4739-8eed-51f76e95b68d",
            "dataType": "int64",
            "modifiedTime": "2026-10-30T04:36:56.013333",
